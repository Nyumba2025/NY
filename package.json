{
  "name": "nyumba-admin",
  "version": "1.0.0",
  "description": "Sistema de gestão de conteúdos Nyumba",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "launch": "node launcher.js",
    "build:exe": "pkg launcher.js --targets node18-win-x64 --output dist/NY_Admin.exe --compress GZip && xcopy /E /I /Y public dist\\public"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "server/**/*",
      "node_modules/**/*"
    ],
    "scripts": [
      "server/**/*.js",
      "launcher.js"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.9.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "fs-extra": "^11.1.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.1",
    "node-cron": "^3.0.2",
    "simple-git": "^3.17.0",
    "winston": "^3.10.0",
    "zip-lib": "^0.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  }
}
